SITE_URL=https://你的预览域名
APP_ORIGIN=https://你的预览域名
DEPLOYMENT_ENV=preview
CONTACT_EMAIL=你的预览客服邮箱
CONTACT_WECHAT=你的预览客服微信
DATABASE_URL=postgresql://你的Neon预览分支连接
RESEND_API_KEY=你的Resend测试密钥
EMAIL_FROM=馥屿预览 <你的已验证测试发信邮箱>
BLOB_READ_WRITE_TOKEN=你的VercelBlob预览令牌
UPSTASH_REDIS_REST_URL=https://你的预览Redis地址
UPSTASH_REDIS_REST_TOKEN=你的预览Redis令牌
CRON_SECRET=你的独立预览定时任务密钥
WECHAT_PAY_ENABLED=false

# Preview 必须使用独立 Neon 分支、Blob 资源前缀/项目、Redis 和邮件测试环境。
# 不要把 Production 的 DATABASE_URL、令牌或真实发信配置复制到 Preview。
# 不要设置 PAYMENT_WEBHOOK_SECRET；Vercel 部署禁用开发支付 webhook，人工收款测试走后台确认。
# VERCEL_ENV 由平台注入；check:env 会确认它与 DEPLOYMENT_ENV 一致。
