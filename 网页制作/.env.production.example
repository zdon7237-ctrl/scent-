SITE_URL=https://你的正式域名
APP_ORIGIN=https://你的正式域名
DEPLOYMENT_ENV=production
# OG_IMAGE=https://你的正式域名/og-image.jpg
CONTACT_EMAIL=你的客服邮箱
CONTACT_WECHAT=你的客服微信
BUSINESS_NAME=你的真实经营主体名称
CUSTOMER_HOURS=12:00 - 20:00
# STUDIO_BOOKING=你的预约方式
DATA_RESIDENCY_DECISION=你的数据驻留决策
DATABASE_URL=postgresql://你的生产数据库连接
RESEND_API_KEY=你的Resend生产密钥
EMAIL_FROM=馥屿 <你的已验证发信邮箱>
# EMAIL_REPLY_TO=你的客服邮箱
BLOB_STORE_ID=你的VercelBlob生产StoreID
UPSTASH_REDIS_KV_REST_API_URL=https://你的生产Redis地址
UPSTASH_REDIS_KV_REST_API_TOKEN=你的生产Redis令牌
CRON_SECRET=你的高强度Vercel定时任务密钥
WECHAT_PAY_ENABLED=false
# WECHAT_PAY_MCH_ID=你的微信支付商户号
# WECHAT_PAY_APP_ID=你的公众号或应用AppID
# WECHAT_PAY_MERCHANT_SERIAL_NUMBER=你的商户证书序列号
# WECHAT_PAY_MERCHANT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."
# WECHAT_PAY_API_V3_KEY=你的APIv3密钥
# WECHAT_PAY_NOTIFY_URL=https://你的正式域名/api/webhooks/wechat-pay
# WECHAT_PAY_PLATFORM_SERIAL_NUMBER=你的微信支付平台证书序列号
# WECHAT_PAY_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."
# ERROR_WEBHOOK_URL=https://你的告警接收地址
# ERROR_WEBHOOK_TOKEN=你的告警鉴权令牌

# 仅用于说明变量名；生产密钥只能写入 Vercel Production 环境，不能提交此文件的真实副本。
# 必须替换所有“你的...”占位，且不要设置 SEED_ADMIN_EMAIL、SEED_ADMIN_PASSWORD 或 PAYMENT_WEBHOOK_SECRET。
# SITE_URL 必须是正式 https:// 域名根地址，不要带末尾 /、路径、查询参数或 #。
# APP_ORIGIN 必须与 SITE_URL 完全一致。
# OG_IMAGE 可选；不设置时会使用站内 /og-image.png 品牌分享图。
# BUSINESS_NAME 在 Production 必填，必须填写真实经营主体，不能使用品牌名占位。
# DATA_RESIDENCY_DECISION 必须为 cross_border_approved 或 domestic_infrastructure。
# STUDIO_BOOKING 可选；不设置时会使用“通过客服微信预约”。
# ERROR_WEBHOOK_URL 和 ERROR_WEBHOOK_TOKEN 必须同时设置或同时省略。
# 第一阶段保持 WECHAT_PAY_ENABLED=false；只有商户资质和全部 API v3 凭据齐全后才设为 true。
# VERCEL_OIDC_TOKEN 由 Vercel 自动注入，不要手工保存；旧 Blob 可改用 BLOB_READ_WRITE_TOKEN。
# 旧 Upstash 集成可改用 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN。
