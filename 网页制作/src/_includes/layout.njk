<!doctype html>
<html lang="zh-CN">
  <head>
{% set baseSiteUrl = siteUrl | default(site.url, true) %}
{% set siteName = site.name | default("馥屿 Scent Atoll", true) %}
{% set shareImage = ogImage | default(site.shareImage, true) %}
{% set pagePath = canonicalPath | default("", true) %}
{% if not pagePath %}
{% if pageKey == "home" %}
{% set pagePath = "/" %}
{% else %}
{% set pagePath = "/" ~ permalink %}
{% endif %}
{% endif %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="theme-color" content="{{ site.themeColor | default('#f7f1e8', true) }}">
{% if noindex or pageKey == "account" or pageKey == "cart" or pageKey == "admin" %}
      <meta name="robots" content="noindex,nofollow">
{% else %}
      <meta name="robots" content="index,follow">
{% endif %}
{% if site.isPlaceholderDomain %}
    <!-- Launch note: set SITE_URL to the production domain before public indexing. -->
{% endif %}
    <link rel="canonical" href="{{ baseSiteUrl }}{{ pagePath }}">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%232b2823'/%3E%3Ctext x='50%25' y='55%25' dominant-baseline='middle' text-anchor='middle' font-family='Georgia,serif' font-size='24' fill='%23f7f1e8'%3ESA%3C/text%3E%3C/svg%3E">
    <meta property="og:site_name" content="{{ siteName }}">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="{{ site.locale | default('zh_CN', true) }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ baseSiteUrl }}{{ pagePath }}">
    <meta property="og:image" content="{{ shareImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="{{ site.shareImageType | default('image/png', true) }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="{{ shareImage }}">
    <link rel="stylesheet" href="styles.css">
  </head>
  <body data-page="{{ pageKey }}" data-public-build="{{ site.isPublicBuild }}">
    <a class="skip-link" href="#main">跳到主要内容</a>

{% if pageKey != "admin" %}{% include "header.njk" %}{% endif %}

    <main id="main"{% if mainClass %} class="{{ mainClass }}"{% endif %}{% if mainAttributes %} {{ mainAttributes | safe }}{% endif %}>
      {{ content | safe }}
    </main>

{% if pageKey != "admin" %}
{% include "footer.njk" %}
{% include "cart-shell.njk" %}
{% endif %}

    <script src="data.js"></script>
    <script src="script.js"></script>
  </body>
</html>
